# Copiar a recolector/.env y completar. NUNCA subir .env a git (está en .gitignore).

# Supabase → Project Settings → API → service_role (secreta: puede escribir en la base).
SUPABASE_SERVICE_KEY=

# Opcional: si no se pone, se usa la URL de js/config.js
# SUPABASE_URL=https://xxxx.supabase.co

# Tema de ntfy donde se publica la ALERTA (el mismo que la central: index.html?jurado&t=ESTE_TEMA).
# Vacío = no se publica en ntfy, solo se sube la lectura.
NTFY_TEMA=rio-suena-eltorno
# NTFY_URL=https://ntfy.sh/

# Solo para el modo continuo (sin --una-vez): minutos entre lecturas
# CADA_MIN=10
