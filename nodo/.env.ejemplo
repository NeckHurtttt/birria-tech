# Copiar a nodo/.env y completar. NUNCA subir .env al repositorio (está en .gitignore).

# Token del bot: hablar con @BotFather en Telegram → /newbot
TELEGRAM_TOKEN=

# Tema del canal: el MISMO que usa la central (index.html?jurado&t=ESTE_TEMA). Solo letras, números, - y _.
TEMA=rio-suena-eltorno

# Clave que la junta les pasa a los vigías para darse de alta: /alta <clave> <puesto>
JUNTA_CLAVE=

# Whisper: tiny (muy rápido) · base · small (recomendado) · medium (lento sin tarjeta de video)
WHISPER_MODELO=small
# WHISPER_GPU=1        # solo con tarjeta NVIDIA

# IA local para clasificar el reporte (opcional; sin esto se usan reglas). Requiere: docker compose --profile ia up -d
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODELO=qwen2.5:3b

# Túnel con URL fija (opcional). Crear el túnel en Cloudflare Zero Trust y pegar su token:
# CLOUDFLARE_TOKEN=
# CLOUDFLARE_CMD=tunnel --no-autoupdate run
